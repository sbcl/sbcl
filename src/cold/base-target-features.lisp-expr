;;;; -*- Lisp -*-

;;;; This software is part of the SBCL system. See the README file for
;;;; more information.
;;;;
;;;; This software is derived from the CMUCL system, which was
;;;; written at Carnegie Mellon University and released into the
;;;; public domain. The software is in the public domain and is
;;;; provided with absolutely no warranty. See the COPYING and CREDITS
;;;; files for more information.

;;;; This file defines the _base_ configuration of SBCL in terms of
;;;; features. Some of these features end up in CL:*FEATURES* and
;;;; SB-IMPL:+INTERNAL-FEATURES+ in the target SBCL; some only affect
;;;; the build.
;;;;
;;;; The effective configuration is computed from this base by
;;;; transforming it with the _localizer_ and then with _customizer_
;;;; if any.
;;;;
;;;; - The localizer is a lambda function read from
;;;;   `local-target-features.lisp-expr'. It is where `make.sh' (via
;;;;   `make-config.sh) writes its `--with-<some-feature>' and
;;;;   `--without-<other-feature>' options along with whatever
;;;;   hardware- and OS-specific default it computes. Note that the
;;;;   localizer is computed from scratch for each `make.sh'
;;;;   invocation; thus, its options do not persist.
;;;;
;;;; - The customizer is another lambda function read from
;;;;   `customize-target-features.lisp' if this file exists (you have
;;;;   to create it) in the base directory of the SBCL tree. The
;;;;   recommended way to somewhat persistently customize the features
;;;;   of a local build is not to edit this file but to define a
;;;;   lambda function in `customize-target-features.lisp' that takes
;;;;   the localized feature list as a parameter and returns the
;;;;   customized feature list. For example, you can use code like
;;;;   this:
;;;;
;;;;     (lambda (list)
;;;;       (flet ((enable (x) (pushnew x list))
;;;;              (disable (x) (setf list (remove x list))))
;;;;         #+nil (enable (feature :sb-show))
;;;;         (enable (feature :sb-after-xc-core))
;;;;         #+nil (disable (feature :sb-doc))
;;;;         list))
;;;;
;;;;   The FEATURE function returns its argument after checking that
;;;;   it's one of the build features listed below.
;;;;
;;;;   With a customizer file, developers can avoid accidentally
;;;;   committing configuration changes and users can avoid the
;;;;   version control conflicts they would risk by editing this file.

;;; List of build features of the format
;;;
;;;     (name default &key (retain :internal) public documentation)
;;;
;;; - NAME is the build feature (a keyword).
;;;
;;; - DEFAULT is whether it's on by default (NIL, T or :AUTO, where
;;;   :AUTO means that `make-config.sh` determines a dynamic default).
;;;
;;; - RETAIN is T, :INTERNAL, or NIL.
;;;
;;;     - T: NAME will be in CL:*FEATURES* in the built SBCL. In this
;;;       case, NAME had better have the :SB- prefix or have a meaning
;;;       that's not SBCL-specific (e.g. :X86).
;;;
;;;     - :INTERNAL: NAME will be in SB-IMPL:+INTERNAL-FEATURES+. This
;;;       is the default. NAME can be anything.
;;;
;;;         FIXME: I suspect that the default should be changed to NIL
;;;         and we should explicitly mark features as :RETAIN
;;;         :INTERNAL that go into SB-IMPL:+INTERNAL-FEATURES+ along
;;;         with the reasoning behind each, rather than features to
;;;         discard and reasons they're not needed. The default
;;;         assumption should be to drop any build-time feature that
;;;         lacks a rationale to preserve it. -- DK
;;;
;;;     - NIL: NAME is dropped after the build. NAME can be anything.
;;;
;;; - If PUBLIC, then it must have DOCUMENTATION, which will be
;;;   included in the user manual.
;;;
;;;     FIXME: We should document all :RETAIN T features (like :X86
;;;     and :LINUX). For that, we may need something like :PUBLIC
;;;     :READ-ONLY. -- MG
(
 ;; I (WHN) made this an optional feature because I came to Common
 ;; Lisp from C++ through Scheme, so I'm accustomed to asking Emacs
 ;; about things that I'm curious about instead of asking the
 ;; executable I'm running.
 (:sb-doc t
  :public t
  :documentation
  "Retain documentation strings found in the system sources in the
  target SBCL executable. Traditional Common Lisp folk will want this
  option set.")

 (:sb-show nil
  :public t
  :documentation
  "Make more debugging information available (for debugging SBCL
  itself). If you aren't hacking or troubleshooting SBCL itself, you
  probably don't want this set.

  At least two varieties of debugging information are enabled by this
  option:

  * SBCL is compiled with a higher level of OPTIMIZE DEBUG, so that
    the debugger can tell more about the state of the system.

  * Various code to print debugging messages, and similar debugging
    code, is compiled only when this feature is present.

  Note that the extra information recorded by the compiler at this
  higher level of OPTIMIZE @DEBUG includes the source location forms.
  In order for the debugger to use this information, it has to re-READ
  the source file. In an ordinary installation of SBCL, this
  re-READing may not work very well, for either of two reasons:

  * The sources aren't present on the system in the same location that
    they were on the system where SBCL was compiled.

  * SBCL is using the standard readtable, without the added hackage
    which allows it to handle things like target features.

 If you want to be able to use the extra debugging information,
 therefore, be sure to keep the sources around, and run with the
 readtable configured so that the system sources can be read.")

 (:sb-ldb t
  :retain t
  :public t
  :documentation
  "Enable the @LDB, the low-level debugger. In the ideal world you
  would not need this unless you are messing with SBCL at a very low
  level (e.g. trying to diagnose GC problems, or trying to debug
  assembly code for a port to a new CPU). However, experience shows
  that sooner or later everyone `lose()`s, in which case `SB-LDB` can
  at least provide an informative backtrace.")

 (:sb-after-xc-core nil
  ;; Essentially an option flag to make-host-2
  :retain nil
  :public t
  :documentation
  "This isn't really a target Lisp feature at all but controls
  whether the build process produces an `after-xc.core` file. This can
  be useful for shortening the edit/compile/debug cycle when you
  modify SBCL's own source code, as in `slam.sh`. Otherwise you don't
  need it.")

 ;; This feature was called :DEBUG in the original CMUCL code.
 (:sb-show-assem nil
  :public t
  :documentation
  "Enable extra debugging output in the `assem.lisp` assembler /
  scheduler code.")

 (:sb-dyncount nil
  :public t
  :documentation
  "Enable code for collecting statistics on usage of various
  operations, useful for performance tuning of the SBCL system itself.
  This code is probably pretty stale (having not been tested since the
  fork from base CMUCL) but might nonetheless be a useful starting
  point for anyone who wants to collect such statistics in the future.")

 ;; Restrict the compiler policy to high safety to debug the hash
 ;; table implementation.
 (:sb-hash-table-debug nil)

 (:sb-simd-pack nil
  :public t
  :documentation
  "Enabled automatically by `make-config.sh` for platforms which
  implement short vector SIMD intrinsics.")

 ;; This is not :RETAIN T, so it doesn't need the :SB- prefix.
 (:cycle-counter nil
  :public t
  :documentation
  "Enabled automatically by `make-config.sh` for platforms which
  implement the `%READ-CYCLE-COUNTER` VOP. Can be disabled manually:
  affects TIME.")

 (:immobile-space nil
  :public t
  :documentation
  "Build with support for an additional dynamic heap differing from
  the main dynamic heap in two ways:

  1. It is guaranteed to reside below 4GB so that all pointers into it
     fit in 32 bits. (Only an issue for >32 bit address space)

  2. All objects therein are immovable, and space is reclaimed by a
     mark-and-sweep collector.

  That combination of aspects potentially allows various efficiencies
  in code generation, especially for the x86-64 backend. The extra
  space has a fixed size which can only be changed by a rebuild, and
  out-of-space conditions are not easily preventable, so the space is
  sized rather generously to sidestep the issue. Additionally, it is
  assumed that for all objects in the immobile heap, speed of
  allocation of those objects is relatively unimportant. If unexpected
  performance regressions are observed, consider disabling this
  feature and reporting a bug.")

 (:immobile-code nil
  :public t
  :documentation
  "Allocate most functions in the immobile space.
  Enabled by default if supported. The down-side of this feature is
  that the allocator is significantly slower than the allocator for
  movable code. If a particular application is performance-constrained
  by speed of creation of compiled functions (not including closures),
  the feature can be disabled.")

 (:compact-instance-header nil
  :public t
  :documentation
  "Combine the layout pointer, instance-length, and widetag of
  an `INSTANCE` into a single machine word. This represents a space
  savings of anywhere from 4% to 8% in typical applications. (Your
  mileage may vary.)")

 ;; Peter Van Eynde's increase-bulletproofness code for CMUCL
 ;;
 ;; Some of the code which was #+high-security before the fork has now
 ;; been either made unconditional, deleted, or rewritten into
 ;; unrecognizability, but some remains. What remains is not maintained
 ;; or tested in current SBCL, but I haven't gone out of my way to
 ;; break it, either.
 (:high-security nil)
 (:high-security-support nil)

 (:sb-thread :auto
  ;; In *FEATURES-POTENTIALLY-AFFECTING-FASL-FORMAT*
  :retain t
  :public t
  :documentation
  "Enable low-level thread primitives support. See SB-MANUAL:@THREADING
  for the list of supported platforms.

  Threads are on by default on

  - x86 / x86-64 Linux, Darwin, and Windows,

  - ARM64, RISC-V, and LoongArch64.

  In fact, threads are mandatory on Windows.")

 (:sb-futex nil
  :retain nil
  :public t
  :documentation
  "Use `futex`es as our locking primitive for lower-overhead
  synchronization. Only available on Linux.")

 (:sb-package-locks t
  :retain t
  :public t
  :documentation
  "Enable detection of unportable code (when applied to the
  `COMMON-LISP` package or SBCL-internal packages) or bad-neighbourly
  code (when applied to user-level packages), relating to material
  alteration to packages or to bindings in symbols in packages. See
  SB-MANUAL:@PACKAGE-LOCKS.")

 (:sb-unicode t
  ;; In *FEATURES-POTENTIALLY-AFFECTING-FASL-FORMAT*
  :retain t
  :public t
  :documentation
  "Support for the entirety of the 21-bit character space defined by
  the Unicode consortium, rather than the classical 8-bit ISO-8859-1
  character set. See SB-MANUAL:@UNICODE-SUPPORT.")

 (:sb-eval t
  :public t
  :documentation
  "Support for a full evaluator that can execute all the CL special
  forms, as opposed to the traditional SBCL evaluator, which called
  COMPILE for everything complicated. See SB-MANUAL:@INTERPRETER.")

 (:sb-fasteval nil
  :public t
  :documentation
  "Support for a different evaluator (interpreter) with improved
  performance. You can have only one of :SB-EVAL AND :SB-FASTEVAL. See
  SB-MANUAL:@INTERPRETER.")

 (:sb-source-locations t
  :public t
  :documentation
  "Record source location information for variables, classes,
  conditions, packages, etc. Gives much better information on
  `\\\\M-.` in Slime but increases core size by about 100kB.")

 (:sb-xref-for-internals nil
  :public t
  :documentation
  "Record xref data for SBCL internals. This can be rather useful for
  people who want to develop on SBCL itself because it will make
  `\\\\M-?` (`slime-edit-uses`) work, which lists call/expansion/etc.
  sites. It will increase the core size by major 5-6MB, though.")

 ;; We support package local nicknames. No :SB- prefix here, as we
 ;; vainly believe our API is worth copying to other implementations
 ;; as well. This doesn't affect the build at all, merely declares how
 ;; things are.
 (:package-local-nicknames t
  ;; Unsure if this is for end-user consumption, though every release
  ;; of SBCL since eons ago has had local nicknames. -- DK
  :retain t)

 (:ansi-compliant-load-truename t
  ;; Silly feature we add in because additive features are more
  ;; sensible than subtractive ones. So you opt out, not in, to having
  ;; *LOAD-TRUENAME* eagerly bound.
  :retain nil
  :public t
  :documentation
  "CLHS says that *LOAD-TRUENAME* has to be bound whenever
  *LOAD-PATHNAME* is because obviously the spec wanted to mandate that
   one system call turn into an unlimited number. At least you're
   correct in saying \"it's not my code, it's the OS that's slow\".
   Remove this feature if you want to ignore the technical requirement
   that *LOAD-TRUENAME* be a variable (as opposed to a symbol-macro).")

 ;; This is set in classic CMUCL, and presumably there it means that
 ;; the floating point arithmetic implementation conforms to IEEE's
 ;; standard. Here it definitely means that the floating point
 ;; arithmetic implementation conforms to IEEE's standard. I (WHN
 ;; 19990702) haven't tried to verify that it does conform, but it
 ;; should at least mostly conform (because the underlying x86
 ;; hardware tries).
 (:ieee-floating-point t
  :retain t)

 ;; CMUCL had, and we inherited, code to support 80-bit LONG-FLOAT on
 ;; the x86 architecture. Nothing has been done to actively destroy
 ;; the long float support, but it hasn't been thoroughly maintained,
 ;; and needs at least some maintenance before it will work. (E.g. the
 ;; LONG-FLOAT-only parts of genesis are still implemented in terms of
 ;; unportable CMUCL functions which are not longer available at
 ;; genesis time in SBCL.) A deeper problem is SBCL's bootstrap
 ;; process implicitly assumes that the cross-compilation host will be
 ;; able to make the same distinctions between floating point types
 ;; that it does. This assumption is fundamentally sleazy, even though
 ;; in practice it's unlikely to break down w.r.t. distinguishing
 ;; SINGLE-FLOAT from DOUBLE-FLOAT; it's much more likely to break
 ;; down w.r.t. distinguishing DOUBLE-FLOAT from LONG-FLOAT. Still
 ;; it's likely to be quite doable to get LONG-FLOAT support working
 ;; again, if anyone's sufficiently motivated.
 (:long-float nil)

 (:largefile nil
  :public t
  :documentation
  "Some platforms don't use a 32-bit `off_t` by default, and thus can't
  handle files larger than 2GB. This feature will control whether
  we'll try to use platform-specific compilation options to enable a
  64-bit `off_t`. The intent is for this feature to be automatically
  enabled by `make-config.sh` on platforms where it's needed and known
  to work, you shouldn't be enabling it manually. You might however
  want to disable it, if you need to pass file descriptors to foreign
  code that uses a 32-bit `off_t`.")

 (:relocatable-static-space nil
  :public t
  :documentation
  "Allow static space to be relocatable on start-up.")

 (:aslr nil
  :public t
  :documentation
  "Allow Lisp spaces to be randomly allocated anywhere in virtual address
  space, i.e. the behavior of passing `mmap` an address of zero.
  Requires all spaces to be relocatable on start-up.")

 (:sb-core-compression nil
  ;; Can't use SB-EXT:SAVE-LISP-AND-DIE :COMPRESSION safely without it
  :retain t
  :public t
  :documentation
  "Support zstd-based compressed core files. Enable this feature to
  compile it in. Obviously, doing so adds a dependency on zstd.")

 (:sb-safepoint :auto
  ;; In *FEATURES-POTENTIALLY-AFFECTING-FASL-FORMAT*
  :retain t
  :public t
  :documentation
  "On certain thread-enabled platforms, synchronization between
  threads for the purpose of stopping and starting the world around GC
  can be performed using safepoints instead of signals. Enable this
  feature to compile with safepoints and to use them for GC. This is
  always enabled on :WIN32. Not enabled elsewhere by default.")

 (:sb-cover-for-internals nil
  :public t
  :documentation
  "Build the SBCL system itself with code coverage data marks (and
   sequences in the compiled code to set those marks). Inevitably,
   this makes the system as a whole slower, but allows coverage of
   tests to be measured.")

 ;; TODO: Which ones should be documented and made public?
 (:bitmapped-conset t)
 (:nonstop-foreign-call nil)
 (:tls-based-mv-return nil)

 ;; ------------------------------------------
 ;; Undocumented stuff to retain in *FEATURES*
 ;; ------------------------------------------

 ;; Standard features (don't disable these)
 (:ansi-cl t :retain t)
 (:common-lisp t :retain t)
 ;; Should we add :X3J13 too?
 ;;
 ;; No. CLHS says ":x3j13 [...] A conforming implementation might or
 ;; might not contain such a feature." -- CSR, 2002-02-21
 ;;
 ;; Our dialect
 (:sbcl t :retain t)

 ;; 32-bit if absent
 (:64-bit :auto :retain t)

 ;; Endianness (mutually exclusive)
 (:big-endian nil :retain t)
 (:little-endian nil :retain t)

 ;; Machine architecture (mutually exclusive)
 (:arm :auto :retain t)
 (:arm64 :auto :retain t)
 (:loongarch64 :auto :retain t)
 (:mips :auto :retain t)
 (:ppc :auto :retain t)
 (:ppc64 :auto :retain t)
 (:riscv :auto :retain t)
 (:sparc :auto :retain t)
 (:x86 :auto :retain t)
 (:x86-64 :auto :retain t)

 ;; Operating system (mutually exclusive)
 (:android :auto :retain t)
 (:darwin :auto :retain t)
 (:dragonfly :auto :retain t)
 (:freebsd :auto :retain t)
 (:gnu-kfreebsd :auto :retain t)
 (:haiku :auto :retain t)
 (:linux :auto :retain t)
 (:netbsd :auto :retain t)
 (:openbsd :auto :retain t)
 (:sunos :auto :retain t)
 (:win32 :auto :retain t)

 ;; Operating system families (not mutually exclusive)
 (:bsd :auto :retain t)
 (:unix :auto :retain t)

 ;; Object file format (mutually exclusive)
 (:elf :auto :retain t)
 (:mach-o :auto :retain t)

 ;; Memory management
 ;;
 ;; I would argue that these should not be exposed, but I would also
 ;; anticipate blowback from removing it. -- DK
 (:allocation-size-histogram nil :retain t)
 (:arena-allocator nil :retain t)
 ;; :CHENEYGC is curiously missing.
 (:gencgc :auto :retain t)
 (:mark-region-gc nil :retain t)

 ;; Features that are also in
 ;; *FEATURES-POTENTIALLY-AFFECTING-FASL-FORMAT* and would probably
 ;; mess up something if made non-public, though I don't think they
 ;; should all be public. -- DK
 (:msan nil :retain t)
 (:ubsan nil :retain t)

 ;; Developer mode features. A normal build will never have them,
 ;; hence it makes no difference whether they're retained or not.
 (:sb-devel nil :retain t)
 (:sb-devel-lock-packages nil :retain t)

 ;; ----------------------------
 ;; Non-public, drop after build
 ;; ----------------------------

 ;; CONS-PROFILING sets the initial compiler policy which persists
 ;; into the default baseline policy. It has no relevance post-build
 ;; in as much as policy can be changed later arbitrarily.
 (:cons-profiling nil :retain nil)
 ;; Used by nothing after compiling target-thread.lisp or thread.c
 (:os-thread-stack nil :retain nil)
 ;; These affect the BREAK instruction emitter, but the C code is able
 ;; to handle anything, and post-build we don't care which it is.
 (:ud2-breakpoints nil :retain nil)
 (:int4-breakpoints nil :retain nil)
 ;; Uses of OS-PROVIDES-DLOPEN and -DLADDR are confined to
 ;; src/code/foreign.lisp
 (:os-provides-dlopen nil :retain nil)
 (:os-provides-dladdr nil :retain nil)
 ;; More or less confined to serve-event, except for a test which now
 ;; detects whether COMPUTE-POLLFDS is defined and therefore
 ;; testable.
 (:os-provides-poll nil :retain nil)
 ;; The final batch of symbols is strictly for C. The LISP_FEATURE_
 ;; prefix on the corresponding #define is unfortunate.
 (:gcc-tls nil :retain nil)
 (:use-sys-mmap nil :retain nil)
 ;; Enforce using of posix semaphores on Darwin instead of dispatch.
 (:use-darwin-posix-semaphores nil :retain nil)
 ;; Only for src/runtime/run-program.c
 (:os-provides-close-range-wrapper nil :retain nil))


;;;; Internals
;;;; ---------
;;;;
;;;; - Any target feature which affects binary compatibility of fasl
;;;;   files needs to be recorded in
;;;;   SB-FASL:*FEATURES-POTENTIALLY-AFFECTING-FASL-FORMAT*.
;;;;
;;;; - #+NIL is used to comment out forms. Occasionally #+IGNORE is
;;;;   used for this too. So don't use :NIL or :IGNORE as the names of
;;;;   features.
;;;;
;;;; - The :SB-XC and :SB-XC-HOST features (which aren't controlled by
;;;;   this file, but are instead temporarily pushed onto *FEATURES*
;;;;   or *TARGET-FEATURES* during some phases of cross-compilation).
;;;;
;;;;   :SB-XC-HOST stands for "cross-compilation host" and is in
;;;;   *FEATURES* during the first phase of cross-compilation
;;;;   bootstrapping, when the host Lisp is being used to compile the
;;;;   cross-compiler.
;;;;
;;;;   :SB-XC stands for "cross compiler", and is in *FEATURES* during
;;;;   the second phase of cross-compilation bootstrapping, when the
;;;;   cross-compiler is being used to create the first target Lisp.
;;;;
;;;; - The :SB-ASSEMBLING feature (which isn't controlled by this
;;;;   file) indicates whether we're in the assembler. It's
;;;;   temporarily pushed onto the *FEATURES* list in the setup for
;;;;   the ASSEMBLE-FILE function. It would be a bad idea to use it as
;;;;   a name for a permanent feature.
