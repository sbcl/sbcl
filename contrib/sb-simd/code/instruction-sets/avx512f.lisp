   (f64.8  f64 512 #:simd-pack-512-double (#:double-avx512-reg))
   (u32.16 u32 512 #:simd-pack-512-ub32   (#:int-avx512-reg))
   (u64.8  u64 512 #:simd-pack-512-ub64   (#:int-avx512-reg))
   (s32.16 s32 512 #:simd-pack-512-sb32   (#:int-avx512-reg))
   (s64.8  s64 512 #:simd-pack-512-sb64   (#:int-avx512-reg)))
  (:simd-casts
   (f32.16 f32.16-broadcast)
   (f64.8  f64.8-broadcast)
   (u32.16 u32.16-broadcast)
   (u64.8  u64.8-broadcast)
   (s32.16 s32.16-broadcast)
   (s64.8  s64.8-broadcast))
  (:reinterpret-casts
   (f32!    sb-simd-avx::f32!-from-p128 sb-simd-avx::f32!-from-p256 f32!-from-p512)
   (f64!    sb-simd-avx::f64!-from-p128 sb-simd-avx::f64!-from-p256 f64!-from-p512)
   (u32!    sb-simd-avx::u32!-from-p128 sb-simd-avx::u32!-from-p256 u32!-from-p512)
   (u64!    sb-simd-avx::u64!-from-p128 sb-simd-avx::u64!-from-p256 u64!-from-p512)
   (f32.16! f32.16!-from-f32 f32.16!-from-p128 f32.16!-from-p256 f32.16!-from-p512)
   (f64.8!  f64.8!-from-f64  f64.8!-from-p128  f64.8!-from-p256  f64.8!-from-p512)
   (u32.16! u32.16!-from-u32 u32.16!-from-p128 u32.16!-from-p256 u32.16!-from-p512)
   (u64.8!  u64.8!-from-u64  u64.8!-from-p128  u64.8!-from-p256  u64.8!-from-p512)
